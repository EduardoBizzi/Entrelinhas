rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validRecord(userId, recordId) {
      let d = request.resource.data;
      return d.keys().hasAll([
        'id', 'userId', 'remoteId', 'title', 'author', 'description',
        'eventAt', 'createdAt', 'updatedAt', 'changeId', 'status', 'pages',
        'totalPages', 'latitude', 'longitude', 'place', 'bookKey',
        'coverUrl', 'deletedAt', 'synced'
      ]) && d.keys().hasOnly([
        'id', 'userId', 'remoteId', 'title', 'author', 'description',
        'eventAt', 'createdAt', 'updatedAt', 'changeId', 'status', 'pages',
        'totalPages', 'latitude', 'longitude', 'place', 'bookKey',
        'coverUrl', 'deletedAt', 'synced'
      ])
      && d.id == recordId && d.remoteId == recordId && d.userId == userId
      && d.title is string && d.title.size() > 0 && d.title.size() <= 160
      && d.author is string && d.author.size() > 0 && d.author.size() <= 200
      && d.description is string && d.description.size() > 0 && d.description.size() <= 2000
      && d.eventAt is timestamp && d.createdAt is timestamp && d.updatedAt is timestamp
      && d.changeId is string && d.changeId.size() == 36
      && d.status in ['planned', 'reading', 'finished']
      && d.pages is int && d.pages >= 0 && d.pages <= 100000
      && d.totalPages is int && d.totalPages >= 0 && d.totalPages <= 100000
      && (d.totalPages == 0 || d.pages <= d.totalPages)
      && d.place is string && d.place.size() <= 200
      && (d.bookKey == null || (d.bookKey is string && d.bookKey.size() <= 200))
      && (d.coverUrl == null || (d.coverUrl is string && d.coverUrl.matches('https://covers[.]openlibrary[.]org/.*')))
      && ((d.latitude == null && d.longitude == null)
        || (d.latitude is number && d.longitude is number
          && d.latitude >= -90 && d.latitude <= 90
          && d.longitude >= -180 && d.longitude <= 180))
      && d.deletedAt == null && d.synced == true;
    }
    match /users/{userId}/registros/{recordId} {
      allow read, delete: if owner(userId);
      allow create: if owner(userId) && validRecord(userId, recordId);
      allow update: if owner(userId) && validRecord(userId, recordId)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
